	(text "** Keep smaller values close to the LED driver IC"
		(exclude_from_sim no)
		(at 245.618 67.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "284fe283-16c7-44b1-bfc0-cae1c2ce09fd")
	)
	(text "Note: UVP protection is probably not needed. If you have it, it\nmay create additional noise at the start of pulses. The efuse\nserves mostly the same purpose and will shutoff if the LEDs get\noverloaded."
		(exclude_from_sim no)
		(at 76.454 62.992 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "34dcb740-59c6-45c8-8bf5-3c3303d3fc89")
	)
	(text "** Keep C_FLT close to the LED driver IC"
		(exclude_from_sim no)
		(at 239.268 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5ea14733-f7e7-43ce-a7ee-b3ee0b6344d8")
	)
	(text "IR LED Current Sense Lines\n\nThe performance is very dependent on these being low noise\nso should be routed as a differential pair and avoid the inductor."
		(exclude_from_sim no)
		(at 211.328 116.078 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "888b3980-5b79-42b3-b5f9-babb27195992")
	)
	(text "IR LED Driver Input Power Bank\n\nGoal is to support 4A spikes for 250us\nwithout depending on any power coming\nin over PoE"
		(exclude_from_sim no)
		(at 218.948 23.622 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9f7766e7-5816-4b7e-b14a-6f158f14c9b2")
	)
	(text "IR LED Decoupling (on LED Driver Output)\n\nThese need to be fast to smooth out the switching\nbut can't be too large otherwise we won't be able to\nachieve sharp 'square' pulses."
		(exclude_from_sim no)
		(at 216.916 79.248 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bd561aea-ff35-4df8-b748-1df1107f3430")
	)
	(text "FSET configured for 400kHz switching frequency."
		(exclude_from_sim no)
		(at 78.994 54.356 0)
