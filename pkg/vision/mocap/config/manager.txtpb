camera_service: "mocap_camera.job.local.cluster.internal"
# make_dummy_cameras: true

initial_camera_config {
    frame_rate: 0
    exposure_micros: 250
    pixel_threshold: 80
    strobe_power: 0.2

    leds_on: true

    # TODO: Dedup.
    blob_filter {
        min_area: 6
        max_area: 10000 # 100 x 100
        reject_edge: true
        max_bbox_aspect_ratio: 1.5
        elliptical_area_error: 0.25
        max_radius_ratio: 1.5
        max_centroid_bbox_skew {
            abs: 2
            rel: 0.05
        }
    }

    # TODO: Dedup.
    mjpeg {
        quality: 100
        downsampling: 1
        max_fps: 5
    }
}

sphere_projection_filter {
    min_angle_check_radius_ratio: 1.2
    max_angle_error_degrees: 10
    max_normalized_radius_ratio: 1.2
}

# TODO: Need this based on a P99
frame_aggregation_timeout: 0.020  # 20ms

matching {
    min_num_matches: 3
    min_num_rematches: 2
    max_reprojection_error: 2.0
    min_marker_distance: 0.015
    ghosting_limit_secs: 0.4

    predictor_alpha: 0.95
    predictor_beta: 0.6
    max_marker_speed: 5

    max_point_jump: 0.1

    min_old_point_matching_ratio: 1.5

    fast_rematch_old_points: true
}

wand {
    left_arm_length: 0.25
    right_arm_length: 0.125
    bottom_length: 0.2
    height: 0.0595

    min_blob_center_pixel_distance: 20.0
    max_blob_center_pixel_distance: 500.0
    max_radius_ratio: 2.0
    max_projection_stretch: 1.5
    max_reprojection_error: 5.0
    collinear_pixel_threshold: 3.0
    min_bottom_line_pixel_distance: 20.0
}

checkerboard {
    grid_width: 8
    grid_height: 13
    square_size: 0.04
}

wanding {
    max_wand_frame_error: 1
    camera_height_guess: 2.1
}

rigid_body_tracker {
    body_config {
        min_initial_match_points: 4
        min_rematch_points: 3
        min_matching_edge_length: 0.05 # 50mm
        max_matching_edge_length: 1 # 1 meter
        max_error: 0.005 # 5mm
    }
}

skeleton_tracker {

    search {
        max_model_point_distance: 0.25
        min_standstill_time_secs: 2
        max_standstill_distance: 0.1
        max_skeleton_scan_fps: 10
    }
}

aux_rpc_server {
    port: 50051
}

