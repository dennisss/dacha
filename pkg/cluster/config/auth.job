name: "ingress.auth"
replicas: 1
worker {
    cwd: "/volumes/bundle"
    args: [
        "/volumes/bundle/built/pkg/cluster/auth/cluster_auth",
        "--port=service"
    ]

    ports {
        name: "service"
        type: TCP
    }

    volumes: [
        {
            name: "bundle"
            build_target: "//pkg/cluster/auth:bundle"
        }
    ]
}
