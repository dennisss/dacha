[Unit]
Description=Cluster Node Runtime
After=network.target time-sync.target network-online.target
Requires=network.target time-sync.target network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=20
User=cluster-node
# Mainly to make sure that systemd enables them in the root '/sys/fs/cgroup/cgroup.subtree_control'
Delegate=yes
WorkingDirectory={base_dir}/bundle
ExecStart={base_dir}/bundle/built/pkg/container/cluster_node --config={base_dir}/config.pb
TimeoutStopSec=30
# Allow some containers to bind to low port numbers like 80, etc.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target