	(text "Level shift from 3.3V (SFP side) to 1.8V (Kiwi side)"
		(exclude_from_sim no)
		(at 200.66 20.828 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0c7c3f6c-3669-4462-8762-17631403d245")
	)
	(text "10Gbps SFP+ connector connected to one of the USGMII ports\n- This is largely based on the Kiwi DVK design.\n- The DVK does have AC coupling on the RD pins but I don't\n  think this is necessary if using compliant SFP+ modules which should have these internally.\n- The level shifters internally have 10K pullups on both side.\n- RX_LOS is open drain so just needs to be pulled up to 1.8V but for simplicity,\n  we just run it through the level shifter which does that for us."
		(exclude_from_sim no)
		(at 16.51 21.844 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b5e1f671-64b2-4a49-a8a3-0026b91aba74")
	)
