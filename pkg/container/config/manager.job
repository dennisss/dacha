name: "system.manager"
replicas: 1
worker {
    args: [
        "/volumes/bundle/built/pkg/cluster/manager/cluster_manager",
        "--port=service"
    ]

    ports {
        name: "service"
        type: TCP
    }

    volumes: [
        {
            name: "bundle"
            build_target: "//pkg/cluster/manager:bundle"
        }
    ]
}
