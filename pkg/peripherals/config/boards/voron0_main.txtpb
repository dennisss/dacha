name: "voron0_main"
base_config: "nrf52840_itsybitsy"

product_id: 10

peripherals {
    name: "stepper_uart"
    uart {
        tx_pin_name: "D10"
        rx_pin_name: "D11"
        config {
            baud_rate: 115200
        }
    }
}

######################################

peripherals {
    name: "stepper1_diag"
    gpio {
        pin_name: "D13"
        config {
            is_input: true
            pull_down: true
            interrupt: HIGH_LEVEL
        }
    }
}
peripherals {
    name: "stepper2_diag"
    gpio {
        pin_name: "SCL"
        config {
            is_input: true
            pull_down: true
            interrupt: HIGH_LEVEL
        }
    }
}
peripherals {
    name: "stepper3_diag"
    gpio {
        pin_name: "D2"
        config {
            is_input: true
            pull_down: true
            interrupt: HIGH_LEVEL
        }
    }
}

######################################

# Drive low to enable the driver.
# Note this is pulled up by the Bigtreetech driver.

peripherals {
    name: "stepper1_enable"
    gpio {
        pin_name: "D12"
        config {
            is_input: false
            default_value: true
        }
    }
}

peripherals {
    name: "stepper2_enable"
    gpio {
        pin_name: "SDA"
        config {
            is_input: false
            default_value: true
        }
    }
}

peripherals {
    name: "stepper3_enable"
    gpio {
        pin_name: "MISO"
        config {
            is_input: false
            default_value: true
        }
    }
}

######################################

# TODO: Optimize the : Keep these next to each other to make the MCU code more efficient.

peripherals {
    name: "stepper1_step"
    stepper {
        step_pin_name: "D9"
        dir_pin_name: "D7"
    }
}

peripherals {
    name: "stepper2_step"
    stepper {
        step_pin_name: "TX_D1"
        dir_pin_name: "RX_D0"
    }
}

peripherals {
    name: "stepper3_step"
    stepper {
        step_pin_name: "MOSI"
        dir_pin_name: "SCK"
    }
}

######################################

pins {
  name: "WIPER_SERVO_PWM"
  alias: "P0.02"
}

peripherals {
    name: "wiper_servo_pwm"
    pwm {
        pin_name: "WIPER_SERVO_PWM"
        config {
            default_value: 0
            frequency: 200
        }
    }
}

######################################

pins {
  name: "BED_RELAY_PWM"
  alias: "P0.31"
}

peripherals {
    name: "bed_relay"
    pwm {
        pin_name: "BED_RELAY_PWM"
        config {
            default_value: 0
            frequency: 2
            timeout_millis: 4000
        }
    }
}

######################################

pins {
  name: "CHASSIS_FAN_PWM"
  alias: "P0.03"
}

peripherals {
    name: "chassis_fan_pwm"
    pwm {
        pin_name: "CHASSIS_FAN_PWM"
        config {
            default_value: 0
            frequency: 25000
        }
    }
}

######################################

pins {
  name: "AIR_FILTER_FAN_PWM"
  alias: "D5"
}

peripherals {
    name: "air_filter_fan_pwm"
    pwm {
        pin_name: "AIR_FILTER_FAN_PWM"
        config {
            default_value: 0
            frequency: 10
        }
    }
}

