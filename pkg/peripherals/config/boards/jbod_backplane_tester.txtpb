name: "jbod_backplane_tester"
base_config: "nrf52840_itsybitsy"

peripherals {
    name: "5v_sense"
    adc {
        pin_name: "P0.30"
        config {
            # Average over 10ms
            oversampling: 256
            sample_rate: 25600
        }
        resistor_divider {
            top_resistor: 10000
            bottom_resistor: 10000
            max_input_voltage: 6
        }
    }
}

peripherals {
    name: "sas_gnd2_sense"
    adc {
        pin_name: "P0.28"
        config {
            # Average over 10ms
            oversampling: 256
            sample_rate: 25600
        }
        resistor_divider {
            top_resistor: 10000
            bottom_resistor: 10000
            max_input_voltage: 6
        }
    }
}

peripherals {
    name: "sas_v2_sense"
    adc {
        pin_name: "P0.31"
        config {
            # Average over 10ms
            oversampling: 256
            sample_rate: 25600
        }
        resistor_divider {
            top_resistor: 10000
            bottom_resistor: 10000
            max_input_voltage: 6
        }
    }
}

peripherals {
    name: "sas_gnd1_sense"
    adc {
        pin_name: "P0.02"
        config {
            # Average over 10ms
            oversampling: 256
            sample_rate: 25600
        }
        resistor_divider {
            top_resistor: 10000
            bottom_resistor: 10000
            max_input_voltage: 6
