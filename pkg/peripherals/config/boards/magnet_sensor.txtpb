name: "magnet_sensor"
base_config: "nrf52840"

product_id: 13

peripherals {
    name: "value"
    adc {
        pin_name: "P0.29"
        config {
            max_voltage: 3.3
            sample_rate: 200000
            oversampling: 16
            vdd_reference: true
        }
    }
}

peripherals {
    name: "buf1"
    buffer {
        config {
            size: 12000  # 6000 u16's (~0.5 seconds of samples)
        }
    }
}