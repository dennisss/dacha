name: "hall_tile"
base_config: "nrf52840"

peripherals {
    name: "value"
    adc {
        pin_name: "P0.29"
        config {
            max_voltage: 1
            sample_rate: 16000
            oversampling: 16
        }
    }
}

peripherals {
    name: "buf1"
    buffer {
        config {
            size: 2000  # 1000 u16's
        }
    }
}