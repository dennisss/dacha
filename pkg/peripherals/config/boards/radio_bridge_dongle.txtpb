# proto-file: pkg/peripherals/proto/service.proto
# proto-message: BoardConfig

name: "radio_bridge_dongle"
base_config: "nrf52840"

peripherals {
    name: "tx_buffer"
    buffer {
        config {
            size: 256
        }
    }
}

peripherals {
    name: "rx_buffer"
    buffer {
        config {
            size: 256
        }
    }
}