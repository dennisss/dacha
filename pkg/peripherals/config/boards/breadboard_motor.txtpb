name: "breadboard_motor"
base_config: "nrf52840_feather"

product_id: 10

peripherals {
    # Drive low to enable the driver.
    # Note this is pulled up by the Bigtreetech driver.
    name: "stepper_enable"
    gpio {
        pin_name: "MOSI"
        config {
            is_input: false
            default_value: true
        }
    }
}

peripherals {
    name: "stepper_uart"
    uart {
        tx_pin_name: "D11"
        rx_pin_name: "D5"
        config {
            baud_rate: 115200
        }
    }
}

peripherals {
    name: "stepper_step"
    stepper {
        step_pin_name: "A1"
        dir_pin_name: "A0"
    }
}

peripherals {
    name: "stepper_diag"
    gpio {
        pin_name: "A5"
        config {
            is_input: true
            pull_down: true
            interrupt: HIGH_LEVEL
        }
    }
}

