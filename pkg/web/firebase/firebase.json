{
  "hosting": [
    {
      "target": "madebydennis-com",
      "public": "sites/madebydennis-com/public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "dacha-dev",
      "rewrites": [
        {
          "source": "**",
          "function": "downloadSourceFile"
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}