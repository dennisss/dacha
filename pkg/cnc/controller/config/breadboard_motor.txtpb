name: "breadboard_motor"

devices: [
    {
        name: "mcu"
        peripheral_config {
            base_config: "breadboard_motor"
        }
    },
    {
        name: "encoder"
        peripheral_config {
            base_config: "motor_encoder_as5047p"
            # base_config: "nrf52840_dongle"
        }
    },
    {
        name: "stepper"
        tmc2209 {
            device_name: "mcu"
            step_peripheral: "stepper_step"
            uart_peripheral: "stepper_uart"
            # diag_peripheral: "stepper_diag"
            enable_peripheral: "stepper_enable"
        }
    }
]

loggers: [
    {
        name: "encoder"

        as5047p {
            spi_peripheral {
                device_name: "encoder"
                peripheral_name: "encoder_spi"
            }
            buffers: ["buf1", "buf2"]
        }
    }
]

time {
    primary_device_name: "mcu"
    trust_usb_sof_timing: true
}

motion_controller {
    motors: [
        {
            device_name: "stepper"
            steps_per_mm: 80
        }
    ]

    geometry: [
        {
            direct {
                motor_name: "stepper"
                axis_index: 0
            }
        }
    ]

    planner {
        max_junction_deviation: 0

        max_instant_speed_change: [
            0
        ]
    }

    axes: [
        { name: "X" max_speed: 200 max_acceleration: 200 }
    ]
}

default_endstops: [
    # "stepper_stall",
    "user_button"
]

endstop_controller {
    #endstops {
    #    name: "stepper_stall"
    #    peripheral {
    #        device_name: "mcu"
    #        peripheral_name: "stepper_diag"
    #    }
    #    motors: ["stepper"]
    #}
    endstops {
        name: "user_button"
        peripheral {
            device_name: "mcu"
            peripheral_name: "button"
        }
        motors: ["stepper"]
    }
}