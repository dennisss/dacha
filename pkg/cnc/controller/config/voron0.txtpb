name: "voron0"

devices: [
    {
        name: "main"
        peripheral_config {
            base_config: "voron0_main"
        }
    },
    {
        name: "toolhead"
        peripheral_config {
            base_config: "voron0_toolhead"
        }
    },
    {
        name: "stepper1"
        tmc2209 {
            device_name: "main"
            step_peripheral: "stepper1_step"
            uart_peripheral: "stepper_uart"
            enable_peripheral: "stepper1_enable"
            addr: 1
        }
    },
    {
        name: "stepper2"
        tmc2209 {
            device_name: "main"
            step_peripheral: "stepper2_step"
            uart_peripheral: "stepper_uart"
            enable_peripheral: "stepper2_enable"
            addr: 0
        }
    },
    {
        name: "stepper3"
        tmc2209 {
            device_name: "main"
            step_peripheral: "stepper3_step"
            uart_peripheral: "stepper_uart"
            enable_peripheral: "stepper3_enable"
            addr: 2
        }
    },
    {
        name: "stepper_extruder"
        tmc2209 {
            device_name: "toolhead"
            step_peripheral: "stepper_step"
            uart_peripheral: "stepper_uart"
            enable_peripheral: "stepper_enable"
        }
    }
]

motion_controller {
    motors: [
        {
            device_name: "stepper1"
            steps_per_mm: 80
        },
        {
            device_name: "stepper2"
            steps_per_mm: 80
        },
        {
            device_name: "stepper3"
            steps_per_mm: 400
            inverted: true
        },
        {
            device_name: "stepper_extruder"
            steps_per_mm: 708.365708
            inverted: true
        }
    ]

    endstops {
        device_name: "main"
        peripheral_name: "stepper1_diag"
        motors: ["stepper1", "stepper2"]
    }

    endstops {
        device_name: "main"
        peripheral_name: "stepper2_diag"
        motors: ["stepper1", "stepper2"]
    }

    #endstops {
    #    device_name: "main"
    #    peripheral_name: "stepper3_diag"
    #    motors: ["stepper3"]
    #}

    geometry: [
        {
            core_xy {
                x_axis_index: 0
                y_axis_index: 1

                a_motor_name: "stepper2"
                b_motor_name: "stepper1"
            }
        },
        {
            direct {
                motor_name: "stepper3"
                axis_index: 2
            }
        },
        {
            direct {
                motor_name: "stepper_extruder"
                axis_index: 3
            }
        }
    ]

    axes: [
        { name: "X" max_speed: 60 max_acceleration: 200 coordination_priority: 0 },
        { name: "Y" max_speed: 60 max_acceleration: 200 coordination_priority: 0 },
        { name: "Z" max_speed: 12 max_acceleration: 20  coordination_priority: 0 },
        { name: "E" max_speed: 10 max_acceleration: 10  coordination_priority: 1 }
    ]
}

heater_controllers {}
