name: "voron0"

devices: [
    {
        name: "main"
        peripheral_config {
            base_config: "voron0_main"
        }
    },
    {
        name: "toolhead"
        peripheral_config {
            base_config: "voron0_toolhead"
        }
    },
    {
        name: "aux"
        peripheral_config {
            base_config: "voron0_aux"
        }
    },
    {
        name: "bed"
        bed_client {
            serial_peripheral {
                device_name: "main"
                peripheral_name: "bed_serial"
            }

            bed_temp_resistor: 999.3,
            sheet_temp_resistor: 998.0,
            aux_temp_resistor: 997.0,
            calibration_a: 0.9963536962,
            calibration_b: -0.0008514803899,
            chip_temp_calibration: 0.955696203
            board_revision: 1
            half_duplex: true
        }
    },

    # {
    #     name: "encoder"
    #     peripheral_config {
    #         base_config: "motor_encoder_as5047p"
    #         # base_config: "filament_sensor"
    #     }
    # },

    {
        name: "stepper1"
        tmc2209 {
            device_name: "main"
            step_peripheral: "stepper1_step"
            uart_peripheral: "stepper_uart"
            enable_peripheral: "stepper1_enable"
            addr: 1
        }
    },
    {
        name: "stepper2"
        tmc2209 {
            device_name: "main"
            step_peripheral: "stepper2_step"
            uart_peripheral: "stepper_uart"
            enable_peripheral: "stepper2_enable"
            addr: 0
        }
    },
    {
        name: "stepper3"
        tmc2209 {
            device_name: "main"
            step_peripheral: "stepper3_step"
            uart_peripheral: "stepper_uart"
            enable_peripheral: "stepper3_enable"
            addr: 2
        }
    },
    {
        name: "stepper_extruder"
        tmc2209 {
            device_name: "toolhead"
            step_peripheral: "stepper_step"
            uart_peripheral: "stepper_uart"
            enable_peripheral: "stepper_enable"
        }
    }
]

led_strips: [
    {
        name: "left"
        num_bytes: 44        
        peripheral {
            device_name: "aux"
            peripheral_name: "leds_left"
        }
    },
    {
        name: "right"
        num_bytes: 44        
        peripheral {
            device_name: "aux"
            peripheral_name: "leds_right"
        }
    },
    {
        name: "bed"
        num_bytes: 4
        peripheral {
            device_name: "bed"
        }
    },
    {
        name: "toolhead"
        num_bytes: 11
        peripheral {
            device_name: "toolhead"
            peripheral_name: "leds"
        }
    }
]

loggers: [
    # {
    #     name: "encoder"

    #     as5047p {
    #         spi_peripheral {
    #             device_name: "encoder"
    #             peripheral_name: "encoder_spi"
    #         }
    #         buffers: ["buf1", "buf2"]
    #     }
    # }

    # {
    #     name: "encoder"

    #     as5601 {
    #         peripheral {
    #             device_name: "encoder"
    #             peripheral_name: "i2c"
    #         }
    #     }
    # }
]

time {
    primary_device_name: "main"
    trust_usb_sof_timing: true
}

motion_controller {
    motors: [
        {
            device_name: "stepper1"
            steps_per_mm: 80
        },
        {
            device_name: "stepper2"
            steps_per_mm: 80
        },
        {
            device_name: "stepper3"
            steps_per_mm: 400
            inverted: true
        },
        {
            device_name: "stepper_extruder"
            steps_per_mm: 708.365708
            inverted: true
        }
    ]

    geometry: [
        {
            core_xy {
                x_axis_index: 0
                y_axis_index: 1

                a_motor_name: "stepper2"
                b_motor_name: "stepper1"
            }
        },
        {
            direct {
                motor_name: "stepper3"
                axis_index: 2
            }
        },
        {
            direct {
                motor_name: "stepper_extruder"
                axis_index: 3
            }
        }
    ]

    planner {
        max_junction_deviation: 0.1

        max_instant_speed_change: [
            0,
            0,
            1,
            1
        ]
    }

    axes: [
        { name: "X" max_speed: 400 max_acceleration: 4000 coordination_priority: 0 },
        { name: "Y" max_speed: 400 max_acceleration: 4000 coordination_priority: 0 },
        { name: "Z" max_speed: 12 max_acceleration: 200  coordination_priority: 0 },
        { name: "E" max_speed: 60 max_acceleration: 10000  coordination_priority: 1 }
    ]
}

default_endstops: ["stepper1_stall", "stepper2_stall"]

endstop_sets: [
    {
        axis: ["X", "Y"]
        min_limit: true
        max_limit: true

        # TODO: Eventually also monitor Z diag
        monitored_endstops: ["stepper1_stall", "stepper2_stall"]
        expected_endstops: ["stepper1_stall", "stepper2_stall"]
    },
    {
        axis: ["Z"]
        min_limit: true

        # TODO: Also monitor X/Y/Z stepper stalls.
        monitored_endstops: ["z_probe"]
        expected_endstops: ["z_probe"]
    }
]

endstop_controller {
    endstops: [
        {
            name: "stepper1_stall"
            peripheral {
                device_name: "main"
                peripheral_name: "stepper1_diag"
            }
            hard: true
            motors: ["stepper1", "stepper2"]
        },
        {
            name: "stepper2_stall"
            peripheral {
                device_name: "main"
                peripheral_name: "stepper2_diag"
            }
            hard: true
            motors: ["stepper1", "stepper2"]
        },

        #endstops {
        #    device_name: "main"
        #    peripheral_name: "stepper3_diag"
        #    motors: ["stepper3"]
        #}

        {
            name: "z_probe"
            peripheral {
                device_name: "toolhead"
                peripheral_name: "probe"
            }
            motors: ["stepper3"]
            # Always keep 1 extra request enqueued while the first one is probing.
            analog_buffers: ["probe_buf1", "probe_buf1"]
        }
    ]

}

heater_controllers {}


fans: [
    {
        group_index: 1
        speed_control {
            device_name: "toolhead"
            peripheral_name: "fan_l_pwm"
        }
    },
    {
        group_index: 1
        speed_control {
            device_name: "toolhead"
            peripheral_name: "fan_r_pwm"
        }
    },
    {
        name: "chassis_fan"
        speed_control {
            device_name: "main"
            peripheral_name: "chassis_fan_pwm"
        }
    },
    {
        name: "air_filter_fan"
        speed_control {
            device_name: "main"
            peripheral_name: "air_filter_fan_pwm"
        }
    }
]

servos: [
    {
        name: "wiper"
        pwm {
            device_name: "main"
            peripheral_name: "wiper_servo_pwm"
        }
    }
]
