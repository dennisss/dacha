  (text "NOTE: The nRF52 REG0 can only do up to 25mA\n(5mA if radio is transmitting)\n\nSo we don't use the REG0. Instead we directly feed 3.3V\nfrom an external LDO.\n\nNOTE: 'Standard drive / low frequency' suggestions on pins are\nonly relevant to radio performance."
    (at 128.27 57.15 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid f649ed45-f409-44b3-9792-fb0b1130b0e7)
  )

